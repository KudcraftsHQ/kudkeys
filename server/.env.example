# Tokens the keyboard may use, comma-separated. Generate with: openssl rand -hex 32
KUDKEYS_TOKENS=
# Groq key used for transcription (the default provider). Never shipped in the APK.
GROQ_API_KEY=
# Optional overrides
# KUDKEYS_PROVIDER=groq            # or openai (then set OPENAI_API_KEY)
# KUDKEYS_MODEL=whisper-large-v3   # or whisper-large-v3-turbo
# KUDKEYS_PAUSE_MS=800             # pause that ends a phrase
# KUDKEYS_PARTIAL_MS=0             # >0 re-sends the phrase in progress for live text; needs request headroom
# KUDKEYS_GROQ_RPM=20              # your Groq requests/minute limit
# KUDKEYS_LANGUAGES=id,en
# KUDKEYS_MAX_SESSION_SECONDS=600
# PORT=8080
