// Kud Keys — Prisma schema.
//
// Accounts (Better Auth), each user's voice profile, one usage row per voice
// stream and one per text call (tidy, fix, instruct). Transcript and text are
// never stored: there is no column for them.
//
// v0.4 sync: the keyboard's settings, the words it knows, and backups
// (server/sync/, contract in server/README.md). Written with raw SQL through
// server/lib/sql.ts so the same queries run on PGlite in tests.
//
// Migration: bunx prisma migrate dev --name <change-name>
// Regenerate client: bunx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through pgbouncer (transaction mode).
  // URL must include `?pgbouncer=true` so Prisma disables prepared statements.
  url       = env("DATABASE_URL_POOLING")
  // Migrations + introspection need a direct connection (pgbouncer can't
  // handle DDL or advisory locks in transaction mode).
  directUrl = env("DATABASE_URL")
}

// ─── Better Auth ────────────────────────────────────────────────────────
// Sign-up is open only to emails in KUDKEYS_ALLOWED_EMAILS (server/auth.ts).

model KudkeysUser {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Voice profile. Names and brands Whisper should spell right; merged into
  // the prompt of every stream this user opens.
  voiceKeywords String[] @default([])
  // Default languages when the keyboard's `start` sends none.
  languages     String[] @default(["id", "en"])

  sessions      KudkeysSession[]
  accounts      KudkeysAccount[]
  voiceSessions VoiceSession[]
  textUsage     TextUsage[]
  settings      KeyboardSettings?
  words         Word[]
  backups       Backup[]

  @@map("kudkeys_user")
}

model KudkeysSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kudkeys_session")
}

model KudkeysAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kudkeys_account")
}

model KudkeysVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("kudkeys_verification")
}

// ─── Usage ──────────────────────────────────────────────────────────────
// One row per voice stream opened with a user session (legacy static tokens
// have no user, so no row). Numbers only: never transcript text, and written
// for private fields too, because nothing here says what was said.

model VoiceSession {
  id           String   @id @default(cuid())
  userId       String
  // The short id the server logs and sends in `ready`.
  session      String
  startedAt    DateTime
  endedAt      DateTime
  audioSeconds Float
  finals       Int
  // stopped | idle | limit | cancelled | client closed | error <code>
  outcome      String
  model        String?

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("voice_session")
}

// One row per /api/text/* call that reached the model. Counts and timing only:
// never the text. For a private field (`private: true`) the character counts
// are null too, so the row says only which kind, when and how long.
model TextUsage {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  // tidy | fix | instruct
  kind      String
  charsIn   Int?
  charsOut  Int?
  ms        Int
  model     String
  ok        Boolean

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("text_usage")
}

// ─── Sync (v0.4) ────────────────────────────────────────────────────────
// The keyboard's settings, one row per user. `prefs` is the merged JSON the
// phones sent (secrets and per-device sizes are left out on the phone).
// Merge is last-writer-wins per key: `keyTimes` holds, for each flattened key
// path (JSON array as text), the device time (epoch ms) of the write that set
// it; a path in keyTimes but not in prefs was removed (sent as null).
model KeyboardSettings {
  userId    String   @id
  prefs     Json
  keyTimes  Json     @default("{}")
  // Newest device time of any key: what GET/PUT answer as `updatedAt`.
  updatedAt DateTime
  // Device that wrote last.
  deviceId  String
  // Server time of the last PUT (the web app's "last synced").
  syncedAt  DateTime
  // Optimistic lock for the read-merge-write in PUT.
  version   Int      @default(0)

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("keyboard_settings")
}

// Words Kud Keys knows the user uses. Merge: union by (word, locale),
// count = max, and a delete is a tombstone (deleted = true) that wins over an
// older add. `updatedAt` is the device's time (the merge rule); `changedAt` is
// the server's time of the last change, which ?since= reads.
model Word {
  userId    String
  word      String
  locale    String
  count     Int
  // typed | swiftkey | manual
  source    String
  deleted   Boolean  @default(false)
  updatedAt DateTime
  changedAt DateTime

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, word, locale])
  @@index([userId, changedAt])
  @@map("word")
}

// The phone's full HeliBoard backup zip, gzip-compressed. Per user the newest
// backup of each of the 14 latest days and 8 latest weeks (Jakarta time) is
// kept; the rest are deleted whenever a backup is added.
model Backup {
  id         String   @id
  userId     String
  createdAt  DateTime
  deviceId   String
  deviceName String
  // auto | manual
  kind       String
  // Size of the zip as uploaded (before gzip).
  sizeBytes  Int
  // sha256 of the zip as uploaded, hex.
  sha256     String
  // gzip(zip)
  data       Bytes

  user KudkeysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("backup")
}
