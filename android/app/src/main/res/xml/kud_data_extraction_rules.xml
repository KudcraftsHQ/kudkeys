<!-- kudkeys: Android 12+ cloud backup and device transfer. Same rule as kud_backup_rules.xml: everything except
     the voice prefs (server URL, token, mic flag) and the voice draft, in both credential- and device-protected storage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kudkeys_voice.xml" />
        <exclude domain="device_sharedpref" path="kudkeys_voice.xml" />
        <exclude domain="sharedpref" path="kudkeys_draft.xml" />
        <exclude domain="device_sharedpref" path="kudkeys_draft.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kudkeys_voice.xml" />
        <exclude domain="device_sharedpref" path="kudkeys_voice.xml" />
        <exclude domain="sharedpref" path="kudkeys_draft.xml" />
        <exclude domain="device_sharedpref" path="kudkeys_draft.xml" />
    </device-transfer>
</data-extraction-rules>
