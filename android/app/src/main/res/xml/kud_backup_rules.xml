<!-- kudkeys: Android Auto Backup (Android 11 and older) keeps the keyboard's settings and dictionaries but never
     the voice prefs (server URL, token, mic flag) and the voice draft (a file in credential-encrypted storage, plus the tidy toggle). The app runs in device-protected
     storage, so both domains. -->
<full-backup-content>
    <exclude domain="sharedpref" path="kudkeys_voice.xml" />
    <exclude domain="device_sharedpref" path="kudkeys_voice.xml" />
    <exclude domain="sharedpref" path="kudkeys_draft.xml" />
    <exclude domain="device_sharedpref" path="kudkeys_draft.xml" />
    <exclude domain="file" path="kudkeys_draft.json" />
    <exclude domain="device_file" path="kudkeys_draft.json" />
</full-backup-content>
