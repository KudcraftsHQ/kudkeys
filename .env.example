# Kud Keys — environment. Copy to .env (server/package.json passes --env-file=../.env).

# Postgres. DATABASE_URL: direct connection, used for migrations (prisma directUrl).
# DATABASE_URL_POOLING: runtime, through pgbouncer with ?pgbouncer=true. Falls back to
# DATABASE_URL when unset. Locally both can point at the same database. Never production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kudkeys"
DATABASE_URL_POOLING="postgresql://postgres:postgres@localhost:5432/kudkeys"

# Better Auth. BETTER_AUTH_URL is the origin the browser uses — in dev that's the Vite
# app port (it proxies /api to the server).
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:5181"
# Extra trusted origins, comma-separated (e.g. the Tailscale host in dev).
# KUDKEYS_ORIGIN="http://hammas-dev.tailaf13a.ts.net:5181"

# Who may sign up. Comma-separated, case-insensitive.
KUDKEYS_ALLOWED_EMAILS="hammas.hamzah@gmail.com"
# Sign-up on/off (default true). Set false once the allowed accounts exist: then nobody can sign up.
# KUDKEYS_SIGNUP_OPEN=true

# Legacy static tokens for /v1/stream, comma-separated, ≥ 24 chars (openssl rand -hex 32).
# Optional: a signed-in account's session token works too.
KUDKEYS_TOKENS=
# Groq key used for transcription (the default provider). Never shipped in the APK.
GROQ_API_KEY=

# Optional overrides
# KUDKEYS_PROVIDER=groq            # or openai (then set OPENAI_API_KEY)
# KUDKEYS_MODEL=whisper-large-v3   # or whisper-large-v3-turbo
# KUDKEYS_PAUSE_MS=800             # pause that ends a phrase
# KUDKEYS_PARTIAL_MS=0             # >0 re-sends the phrase in progress for live text; needs request headroom
# KUDKEYS_GROQ_RPM=20              # your Groq requests/minute limit
# KUDKEYS_LANGUAGES=id,en          # default when neither `start` nor the profile names any
# KUDKEYS_MAX_SESSION_SECONDS=600
# PORT=8080
